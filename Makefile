# Build CV and resume; publication lists are generated from pubs/*.bib.
## Makefile completed generated by Claude with minor additions by me
PUBS   = $(wildcard pubs/*.bib)
GENDEP = bin/makepubs.py bin/bibcv.py $(PUBS)

default: cv.pdf resume.pdf

.PHONY: default check clean

pubs-cv.tex: $(GENDEP)
	bin/makepubs.py cv > $@.tmp && mv $@.tmp $@

pubs-resume.tex: $(GENDEP)
	bin/makepubs.py resume > $@.tmp && mv $@.tmp $@

cv.pdf: cv.tex resume.cls pubs-cv.tex
	latexmk -pdf -interaction=nonstopmode -halt-on-error cv.tex

resume.pdf: resume.tex myresume.sty pubs-resume.tex
	latexmk -lualatex -interaction=nonstopmode -halt-on-error resume.tex

# sanity-check every entry in pubs/
check:
	bin/makepubs.py check

clean:
	latexmk -c cv.tex resume.tex
	rm -f pubs-cv.tex pubs-resume.tex *.tmp

clean-pdf:
	rm -f *.pdf
